# Wellness Buddy Environment Configuration
# Copy this file to .env and fill in your actual values

# DeepSeek API Configuration (Required for AI features)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Database Configuration
DATABASE_PATH=wellness_buddy.db

# Optional: Other LLM APIs (for future extensions)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Development settings
# DEBUG=true
# LOG_LEVEL=info

# Instructions:
# 1. Get your DeepSeek API key from: https://platform.deepseek.com/
# 2. Copy this file to .env: cp .env.example .env
# 3. Replace 'your_actual_deepseek_api_key_here' with your real API key
# 4. Restart the backend server: python -m uvicorn api:app --reload --port 8000 